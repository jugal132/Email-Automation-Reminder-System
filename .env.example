# ==============================================================================
# Email Automation & Reminder System - Environment Configuration
# ==============================================================================
# Note: Copy this file to '.env' and fill in local values. Never commit '.env'.

# Execution mode: 'simulation' (default, safe) or 'live'
EMAIL_MODE=simulation

# Safety Gate Control: Live transmission is BLOCKED unless explicitly set to 'true'
# Default: false
ALLOW_REAL_EMAILS=false

# SMTP Server Configuration (Placeholders - do not commit real credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_SENDER=your_email@example.com
EMAIL_FROM=your_email@example.com
EMAIL_FROM_NAME=Email Automation System
SMTP_TIMEOUT=10.0

# Application Settings
LOG_LEVEL=INFO
DATABASE_PATH=data/email_automation.db
RETRY_LIMIT=3
RETRY_DELAY_SECONDS=5
